# =========================================================================
# Environment Configuration - AI-Powered Personal Diet Planner Cloud
# =========================================================================

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# JWT Authentication Security Secret
JWT_SECRET_KEY=diet_planner_cloud_super_secret_jwt_key_2026

# Optional: External LLM API (If empty, automatically uses rule-based knapsack fallback)
AI_API_KEY=
AI_MODEL_NAME=gemini-1.5-flash

# Optional: Cloud Managed Database (Leave blank to use local SQLite simulation)
CLOUD_DB_TYPE=sqlite
DATABASE_URL=data/diet_planner_cloud.db

# Optional: Cloud Object Storage (Leave blank to use local bucket simulation)
CLOUD_STORAGE_TYPE=local
STORAGE_BUCKET_NAME=storage_bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
